{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/docs/",
      "permanent": false
    },
    {
      "source": "/docs/embedded",
      "destination": "/docs/integration",
      "permanent": true
    },
    {
      "source": "/docs/embedded/",
      "destination": "/docs/integration",
      "permanent": true
    },
    {
      "source": "/docs/messages",
      "destination": "/docs/integration",
      "permanent": true
    },
    {
      "source": "/docs/messages/",
      "destination": "/docs/integration",
      "permanent": true
    },
    {
      "source": "/docs/examples/basic-iframe",
      "destination": "/docs/examples/helper-script/",
      "permanent": true
    },
    {
      "source": "/docs/examples/basic-iframe/",
      "destination": "/docs/examples/helper-script/",
      "permanent": true
    },
    {
      "source": "/docs/examples/dynamic-unit-selection",
      "destination": "/docs/examples/helper-script/",
      "permanent": true
    },
    {
      "source": "/docs/examples/dynamic-unit-selection/",
      "destination": "/docs/examples/helper-script/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/docs/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; connect-src 'self' https://widgets.hypo.tech; font-src 'self'; frame-src https://widgets.hypo.tech; img-src 'self' data: https://widgets.hypo.tech; object-src 'none'; script-src 'self' https://widgets.hypo.tech 'sha256-ng8W1FnGVqbzCCV1hV2EGXSMN/WlYnkoQZy8x1kkcsM='; style-src 'self' 'unsafe-inline'; form-action 'none'; frame-ancestors 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
